{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "sortImports": {
    "customGroups": [
      {
        "groupName": "react",
        "elementNamePattern": ["react", "react-dom"],
        "selector": "external"
      },
      {
        "groupName": "vite",
        "elementNamePattern": ["vite", "vitest"],
        "selector": "external"
      },
      {
        "groupName": "workspace",
        "elementNamePattern": ["@repo/**"]
      }
    ],
    "groups": [
      "builtin",
      ["react"],
      ["vite"],
      { "newlinesBetween": false },
      "external",
      "workspace",
      ["internal", "subpath"],
      ["parent", "sibling", "index"],
      "style",
      "unknown"
    ],
    "internalPattern": ["~/", "@/", "#/"]
  },
  "sortTailwindcss": true,
  "ignorePatterns": [
    "package-lock.json",
    "pnpm-lock.yaml",
    ".cta.json",
    "routeTree.gen.ts",
    "components.json",
    "index.html",
    "README.md",
    "tsconfig.json",
    ".*/**"
  ]
}
